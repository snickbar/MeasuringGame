{
  "appId": "com.snickbar.sizeemup",
  "appName": "Size Em Up!",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "providers": [
        "google.com"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 10000,
      "resetWhenUpdate": true
    }
  }
}
