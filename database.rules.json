{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": false,
      ".write": false,
      "$roomCode": {
        ".read": "$roomCode.matches(/^[A-Z0-9]{4}$/)",
        ".write": "$roomCode.matches(/^[A-Z0-9]{4}$/)"
      }
    },
    "profiles": {
      ".read": false,
      ".write": false,
      "$id": {
        ".read": "$id.matches(/^[a-f0-9]{32}$/) || (auth != null && auth.uid === $id)",
        ".write": "$id.matches(/^[a-f0-9]{32}$/) || (auth != null && auth.uid === $id)"
      }
    }
  }
}
