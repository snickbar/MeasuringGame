{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": false,
      ".write": false,
      "$roomCode": {
        ".read": "$roomCode.matches(/^[A-Z0-9]{4}$/)",
        ".write": "$roomCode.matches(/^[A-Z0-9]{4}$/)",
        "players": {
          "$pid": {
            ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,64}$/)",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{0,40}$/)"
            }
          }
        },
        "finishedPlayers": {
          "$pid": {
            ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,64}$/)",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{0,40}$/)"
            }
          }
        },
        "guesses": {
          "$pid": {
            ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.isNumber()"
          }
        },
        "picks": {
          "$pid": {
            ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,64}$/)"
          }
        }
      }
    },
    "profiles": {
      ".read": false,
      ".write": false,
      "$id": {
        ".read": "$id.matches(/^[a-f0-9]{32}$/) || (auth != null && auth.uid === $id)",
        ".write": "$id.matches(/^[a-f0-9]{32}$/) || (auth != null && auth.uid === $id)",
        "_writeVersion": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))"
        }
      }
    },
    "codes": {
      ".read": false,
      ".write": false,
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z0-9]{1,20}$/)",
        ".write": false
      }
    },
    "dailyCombos": {
      ".read": true,
      ".write": false,
      "$date": {
        ".read": true,
        ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        ".write": "!data.exists() && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      }
    },
    "daily": {
      ".read": false,
      ".write": false,
      "$date": {
        ".read": true,
        ".indexOn": [
          "s"
        ],
        "$id": {
          ".write": "(($id.matches(/^[a-f0-9]{32}$/) && newData.child('h').val() === 1) || (auth != null && auth.uid === $id)) && !data.exists() && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          ".validate": "newData.hasChildren(['n','s','a','t']) && newData.child('s').val() <= newData.child('a/0').val() + newData.child('a/1').val() + newData.child('a/2').val() + 2",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
          },
          "a": {
            "$i": {
              ".validate": "$i.matches(/^[0-2]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            }
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 86400000"
          },
          "h": {
            ".validate": "newData.val() === 1"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "monthlyCombos": {
      ".read": true,
      ".write": false,
      "$key": {
        ".read": true,
        ".write": "!data.exists() && $key.matches(/^[0-9]{4}-[0-9]{2}$/)"
      }
    },
    "monthly": {
      ".read": false,
      ".write": false,
      "$key": {
        ".read": true,
        ".indexOn": [
          "s"
        ],
        "$id": {
          ".write": "(($id.matches(/^[a-f0-9]{32}$/) && newData.child('h').val() === 1) || (auth != null && auth.uid === $id)) && !data.exists()",
          ".validate": "newData.hasChildren(['n','s','a','t'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "a": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            }
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 86400000"
          },
          "h": {
            ".validate": "newData.val() === 1"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "survival": {
      ".read": true,
      ".indexOn": [
        "s"
      ],
      "$id": {
        ".write": "(($id.matches(/^[a-f0-9]{32}$/) && newData.child('h').val() === 1) || (auth != null && auth.uid === $id)) && (!data.exists() || newData.child('s').val() > data.child('s').val())",
        ".validate": "newData.hasChildren(['n','s','t'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "s": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5000"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now + 86400000"
        },
        "h": {
          ".validate": "newData.val() === 1"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
